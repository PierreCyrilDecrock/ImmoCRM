# Modèle de configuration. Copier ce fichier sous le nom « .env.local » (jamais suivi par git)
# et remplir les deux valeurs avec celles du projet Supabase de TEST.
# Où les trouver : Supabase → projet → Project Settings → API (ou « API Keys »).
#
# Uniquement la clé PUBLIQUE (« anon » ou « publishable »).
# Jamais la clé d'administration (« service_role » ou « secret »).

# Adresse du projet, de la forme https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Clé publique du projet
VITE_SUPABASE_CLE_PUBLIQUE=
